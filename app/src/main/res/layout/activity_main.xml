<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:text="Gestor de Inventario"
            android:textAlignment="center"
            android:textColor="@color/primary_soft"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <EditText
                    android:id="@+id/etId"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_border"
                    android:hint="ID del producto"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/etTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Nombre del producto"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_border"
                    android:gravity="top"
                    android:hint="Descripción del producto"
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/etCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Cantidad"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_hint" />

                <CheckBox
                    android:id="@+id/cbCompletada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:buttonTint="@color/accent_teal"
                    android:text="Disponible en stock"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <!-- Panel de Acciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageButton
                        android:id="@+id/btnBuscar"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/button_action_bg"
                        android:src="@drawable/buscar"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnGuardar"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/button_primary_bg"
                        android:src="@drawable/guardar"
                        android:padding="14dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnEditar"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/button_action_bg"
                        android:src="@drawable/edit"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnEliminar"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/button_danger_bg"
                        android:src="@drawable/delete"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnVerTodas"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/primary_soft"
                    android:text="VER INVENTARIO COMPLETO"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnVerUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/accent_teal"
                    android:text="GESTIONAR USUARIOS"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>